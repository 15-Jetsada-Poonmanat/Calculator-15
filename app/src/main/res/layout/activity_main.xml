<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#3F88D0"
    android:padding="16dp"
    android:id="@+id/main"
    >
    
    <!--หน้าจอแสดงผล-->
    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:padding="16dp"
        android:textColor="@color/black"
        android:gravity="end"
        android:background="#66B49C"
        android:layout_marginBottom="12dp"
        android:textSize="36dp"/>
    
    <!--โซนปุ่ม-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!--แถวที่ 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--แต่ละปุ่ม-->
            <Button
                android:id="@+id/bthAC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="AC"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEL"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthMod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="/"
                android:layout_margin="4dp"/>

            </LinearLayout>
        <!--แถวที่ 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--แต่ละปุ่ม-->
            <Button
                android:id="@+id/bth7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="7"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="8"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="9"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthmultiplication"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="×"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!--แถวที่ 3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--แต่ละปุ่ม-->
            <Button
                android:id="@+id/bth4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="4"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthminus_sign"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!--แถวที่ 4-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--แต่ละปุ่ม-->
            <Button
                android:id="@+id/bth1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthplus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="+"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!--แถวที่ 5-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!--แต่ละปุ่ม-->
            <Button
                android:id="@+id/bthplus_minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="±"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bth0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="0"
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/btho_"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="."
                android:layout_margin="4dp"/>
            <Button
                android:id="@+id/bthequal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="="
                android:layout_margin="4dp"/>


        </LinearLayout>




    </LinearLayout>
    
    
    
    
    
</LinearLayout>